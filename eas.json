{
  "build": {
    "preview-devClient": {
      "developmentClient": true
    },
    "preview-android": {
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios": {
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your@apple.com",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}